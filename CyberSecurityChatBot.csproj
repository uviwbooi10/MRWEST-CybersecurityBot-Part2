<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<RootNamespace>THEPART2</RootNamespace>
		<AssemblyName>CybersecurityChatbot</AssemblyName>
	</PropertyGroup>
	<!-- Copy greeting.wav to output automatically -->
	<ItemGroup>
		<None Update="greeting.wav">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<!-- JSON library for task storage (TaskStorageHelper.cs) -->
	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>
</Project>
