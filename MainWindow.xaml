<Window x:Class="THEPART2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MrWest Cybersecurity Bot" Height="750" Width="950"
        MinHeight="650" MinWidth="800"
        Background="#0D0D0D"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00FF9C"/>
            <Setter Property="Foreground" Value="#0D0D0D"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00CC7A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SendButtonStyle}">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#00FF9C"/>
            <Setter Property="BorderBrush" Value="#00FF9C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252540"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="CaretBrush" Value="#00FF9C"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#00FF9C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00FF9C"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#0A0A1A"/>
            <Setter Property="Foreground" Value="#666699"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#00FF9C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Tab content -->
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER ═══════════ -->
        <Border Grid.Row="0" Background="#0A0A1A" BorderBrush="#00FF9C" BorderThickness="0,0,0,2" Padding="16,10">
            <StackPanel>
                <TextBlock FontFamily="Consolas" FontSize="9" Foreground="#00FF9C"
                           TextAlignment="Center" HorizontalAlignment="Center"
                           Text="&#10;  ███╗   ███╗██████╗     ██╗    ██╗███████╗███████╗████████╗&#10;  ████╗ ████║██╔══██╗    ██║    ██║██╔════╝██╔════╝╚══██╔══╝&#10;  ██╔████╔██║██████╔╝    ██║ █╗ ██║█████╗  ███████╗   ██║   &#10;  ██║╚██╔╝██║██╔══██╗    ██║███╗██║██╔══╝  ╚════██║   ██║   &#10;  ██║ ╚═╝ ██║██║  ██║    ╚███╔███╔╝███████╗███████║   ██║   &#10;  ╚═╝     ╚═╝╚═╝  ╚═╝     ╚══╝╚══╝ ╚══════╝╚══════╝   ╚═╝   "/>
                <TextBlock Text="CYBERSECURITY BOT  |  Stay Safe Online  |  ST10491015 — Uviwe Booi"
                           FontFamily="Consolas" FontSize="10" Foreground="#666699"
                           TextAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══════════ TAB CONTROL ═══════════ -->
        <TabControl Grid.Row="1" Background="#0D0D0D" BorderThickness="0">

            <!-- ───────── TAB 1: CHAT ───────── -->
            <TabItem Header="💬 CHAT">
                <Grid Background="#0D0D0D">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <StackPanel x:Name="ChatPanel" VerticalAlignment="Bottom"/>
                    </ScrollViewer>

                    <Border Grid.Row="1" Background="#0A0A1A" BorderBrush="#00FF9C" BorderThickness="0,2,0,0" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UserInputBox" Grid.Column="0" Style="{StaticResource InputStyle}"
                                     Height="44" VerticalContentAlignment="Center"
                                     KeyDown="UserInputBox_KeyDown" Margin="0,0,10,0"/>
                            <Button x:Name="SendButton" Grid.Column="1" Content="SEND"
                                    Style="{StaticResource SendButtonStyle}" Height="44" Width="90"
                                    Click="SendButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ───────── TAB 2: TASK ASSISTANT ───────── -->
            <TabItem Header="✅ TASKS">
                <Grid Background="#0D0D0D" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Add Task Form -->
                    <Border Grid.Row="0" Background="#0A0A1A" BorderBrush="#00FF9C" BorderThickness="1" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ADD NEW TASK" Style="{StaticResource LabelStyle}" FontSize="14" Margin="0,0,0,8"/>

                            <TextBlock Text="Title" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TaskTitleBox" Style="{StaticResource InputStyle}" Height="34"/>

                            <TextBlock Text="Description" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TaskDescriptionBox" Style="{StaticResource InputStyle}" Height="34"/>

                            <TextBlock Text="Reminder (e.g. 'Remind me in 5 days')" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TaskReminderBox" Style="{StaticResource InputStyle}" Height="34"/>

                            <Button x:Name="AddTaskButton" Content="➕ ADD TASK" Style="{StaticResource SendButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" Click="AddTaskButton_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Task List -->
                    <Border Grid.Row="1" Background="#0A0A1A" BorderBrush="#00FF9C" BorderThickness="1" Padding="12">
                        <ListBox x:Name="TaskListBox" Background="Transparent" BorderThickness="0"
                                 Foreground="#E0E0E0" FontFamily="Consolas" FontSize="12"/>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Left">
                        <Button x:Name="MarkCompleteButton" Content="✔ MARK COMPLETE" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,0" Click="MarkCompleteButton_Click"/>
                        <Button x:Name="DeleteTaskButton" Content="🗑 DELETE" Style="{StaticResource SecondaryButtonStyle}"
                                Click="DeleteTaskButton_Click"/>
                        <Button x:Name="RefreshTasksButton" Content="🔄 REFRESH" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="10,0,0,0" Click="RefreshTasksButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ───────── TAB 3: QUIZ ───────── -->
            <TabItem Header="🎮 QUIZ">
                <Grid Background="#0D0D0D" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Score tracker -->
                    <Border Grid.Row="0" Background="#0A0A1A" BorderBrush="#00FF9C" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="QuizProgressText" Grid.Column="0" Text="Press Start Quiz to begin!"
                                       Foreground="#00FF9C" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"/>
                            <Button x:Name="StartQuizButton" Grid.Column="1" Content="▶ START QUIZ"
                                    Style="{StaticResource SendButtonStyle}" Click="StartQuizButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Question area -->
                    <Border Grid.Row="1" Background="#0A0A1A" BorderBrush="#00FF9C" BorderThickness="1" Padding="20">
                        <StackPanel>
                            <TextBlock x:Name="QuizQuestionText" Text="Click 'Start Quiz' to test your cybersecurity knowledge!"
                                       Foreground="#E0E0E0" FontFamily="Consolas" FontSize="14"
                                       TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <StackPanel x:Name="QuizOptionsPanel"/>
                        </StackPanel>
                    </Border>

                    <!-- Feedback area -->
                    <Border Grid.Row="2" Background="#0A1A14" BorderBrush="#00FF9C" BorderThickness="0,1,0,0" Padding="12" Margin="0,12,0,0">
                        <TextBlock x:Name="QuizFeedbackText" Text="" Foreground="#00FF9C"
                                   FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Submit / Next buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SubmitAnswerButton" Content="SUBMIT ANSWER" Style="{StaticResource SendButtonStyle}"
                                Click="SubmitAnswerButton_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
