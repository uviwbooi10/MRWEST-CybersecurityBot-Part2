<Window x:Class="PART2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PART2"
        mc:Ignorable="d"
   
        Title="MrWest Cybersecurity Bot" Height="700" Width="900"
        MinHeight="600" MinWidth="750"
        Background="#0D0D0D"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Send Button Style -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00FF9C"/>
            <Setter Property="Foreground" Value="#0D0D0D"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00CC7A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Input TextBox Style -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="CaretBrush" Value="#00FF9C"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#00FF9C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header / ASCII Art -->
            <RowDefinition Height="*"/>
            <!-- Chat Display -->
            <RowDefinition Height="Auto"/>
            <!-- Input Row -->
            <RowDefinition Height="Auto"/>
            <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- ROW 0: HEADER -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White" BorderBrush="Black" BorderThickness="0,0,0,2" Padding="16,12">
            <StackPanel>
                <!-- ASCII Art Logo -->

                <!-- Subtitle -->
                <TextBlock x:Name="AsciiArtBlock"
                           FontFamily="Consolas"
                           FontSize="9"
                           Foreground="#161817"
                           TextAlignment="Center"
                           Text="&#xA;  ███╗   ███╗██████╗     ██╗    ██╗███████╗███████╗████████╗&#xA;  ████╗ ████║██╔══██╗    ██║    ██║██╔════╝██╔════╝╚══██╔══╝&#xA;  ██╔████╔██║██████╔╝    ██║ █╗ ██║█████╗  ███████╗   ██║   &#xA;  ██║╚██╔╝██║██╔══██╗    ██║███╗██║██╔══╝  ╚════██║   ██║   &#xA;  ██║ ╚═╝ ██║██║  ██║    ╚███╔███╔╝███████╗███████║   ██║   &#xA;  ╚═╝     ╚═╝╚═╝  ╚═╝     ╚══╝╚══╝ ╚══════╝╚══════╝   ╚═╝   "/>

                <!-- Subtitle -->
                <TextBlock Text="CYBERSECURITY BOT  |  Stay Safe Online  |  Uviwe Booi"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="Black"
                           TextAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- ROW 1: CHAT DISPLAY -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ScrollViewer x:Name="ChatScrollViewer"
                      Grid.Row="1"
                      Background="White"
                      VerticalScrollBarVisibility="Auto"
                      Padding="16,12" Margin="0,7,0,63" Grid.RowSpan="2">
            <StackPanel x:Name="ChatPanel" VerticalAlignment="Bottom"/>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- ROW 2: INPUT ROW -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0A0A1A" BorderBrush="Black" BorderThickness="0,2,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInputBox"
                         Grid.Column="0"
                         Style="{StaticResource InputStyle}"
                         Height="44"
                         VerticalContentAlignment="Center"
                         KeyDown="UserInputBox_KeyDown"
                         Margin="0,0,10,0"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="SEND"
                        Style="{StaticResource SendButtonStyle}"
                        Height="44"
                        Width="90"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- ROW 3: STATUS BAR -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#050510" Padding="16,6">
            <TextBlock x:Name="StatusBar"
                       Text=" MrWest Cybersecurity Bot — Ready"
                       FontFamily="Consolas"
                       FontSize="10"
                       Foreground="White"/>
        </Border>
    </Grid>
</Window>
